{
  "name": "humor-skills",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "audit:ogiri-ai": "node src/ogiri-ai/rule-audit.ts",
    "audit:overlap-check": "node skills/overlap-check/scripts/evaluate.ts skills/overlap-check/assets/samples.json reports/overlap-check/results.json",
    "audit:trait-check": "node skills/trait-check/scripts/evaluate.ts skills/trait-check/assets/samples.json reports/trait-check/results.json && node skills/trait-check/scripts/compare.ts skills/trait-check/assets/pairs.json reports/trait-check/compare-results.json",
    "validate:jev": "node src/validation/run-jev.ts",
    "validate:blind": "node src/validation/blind.ts",
    "validate:agreement": "node src/validation/agreement.ts"
  },
  "devDependencies": {
    "@types/json-schema": "^7.0.15",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  }
}
